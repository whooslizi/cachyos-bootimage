pkgname=bootc
pkgver=1.16.3
pkgrel=1
pkgdesc="Transactional, bootable container manager"
arch=('x86_64')
url="https://github.com/bootc-dev/bootc"
license=('Apache')

depends=(
  ostree
  systemd
)

makedepends=(
  git
  rust
  go-md2man
  pkgconf
)

source=(
  "git+https://github.com/bootc-dev/bootc.git#tag=v${pkgver}"
)

sha256sums=('SKIP')

build() {
    cd bootc
    make bin
}

package() {
    cd bootc
    make install-all DESTDIR="$pkgdir"
}
